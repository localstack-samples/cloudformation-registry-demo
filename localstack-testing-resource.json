{
  "typeName": "LocalStack::Testing::Resource",
  "description": "Lambda compatible queue for subscribing to messages",
  "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-rpdk.git",
  "properties": {
    "TopicArn": {
      "type": "string",
      "description": "ARN of the topic"
    },
    "QueueUrl": {
      "type": "string",
      "description": "URL of the queue"
    },
    "SubscriptionArn": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "createOnlyProperties": [
    "/properties/TopicArn"
  ],
  "readOnlyProperties": [
    "/properties/QueueUrl",
    "/properties/SubscriptionArn"
  ],
  "primaryIdentifier": [
    "/properties/QueueUrl"
  ],
  "handlers": {
    "create": {
      "permissions": [
        "sqs:CreateQueue",
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sns:Subscribe"
      ]
    },
    "read": {
      "permissions": [
      ]
    },
    "update": {
      "permissions": [
      ]
    },
    "delete": {
      "permissions": [
        "sns:Unsubscribe",
        "sqs:DeleteQueue"
      ]
    },
    "list": {
      "permissions": [
      ]
    }
  }
}
